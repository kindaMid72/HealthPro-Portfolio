# Environment Variables — Template
# Salin file ini jadi .env.local lalu isi nilai-nilainya.
# JANGAN commit .env.local ke git (sudah ada di .gitignore).

# -----------------------------------------------------------------------
# Database — Postgres lokal (docker compose up -d db)
# Kredensial contoh (postgres/postgres) HANYA untuk lokal; port DB hanya di loopback.
# Produksi (Neon): DATABASE_URL = role aplikasi non-owner (pooled),
# DATABASE_URL_UNPOOLED = role owner, hanya untuk migrasi.
# -----------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mami

# -----------------------------------------------------------------------
# HMAC key untuk dedupe view artikel (wajib di produksi). Buat: openssl rand -base64 32
# -----------------------------------------------------------------------
VIEW_HASH_SECRET=

# -----------------------------------------------------------------------
# Google Sheets — HANYA untuk `npm run db:import-sheets` (migrasi awal, dihapus setelah cutover)
# Cara dapat URL: File → Share → Publish to web → pilih tab → format CSV
# -----------------------------------------------------------------------
SHEET_CSV_URL_PROFILE=
SHEET_CSV_URL_LOCATIONS=
SHEET_CSV_URL_SERVICES=

# -----------------------------------------------------------------------
# Site URL — dipakai untuk canonical URL, OG image, dan sitemap
# Di development: http://localhost:3000
# Di production (Vercel): https://<domain>
# -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
