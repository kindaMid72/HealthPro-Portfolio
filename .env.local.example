# Environment Variables — Template
# Copy this file to .env.local and fill in the values.
# DO NOT commit .env.local to git (already ignored in .gitignore).

# -----------------------------------------------------------------------
# Database — Local Postgres (docker compose up -d db)
# Example credentials (postgres/postgres) are ONLY for local use; DB port is on loopback only.
# Production (Neon): DATABASE_URL = non-owner application role (pooled),
# DATABASE_URL_UNPOOLED = owner role, only for migrations.
# -----------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mami

# -----------------------------------------------------------------------
# HMAC key for article view deduplication (mandatory in production). Generate: openssl rand -base64 32
# -----------------------------------------------------------------------
VIEW_HASH_SECRET=

# -----------------------------------------------------------------------
# Google Sheets — ONLY for `npm run db:import-sheets` (initial migration, removed after cutover)
# How to get URLs: File → Share → Publish to web → select tab → CSV format
# -----------------------------------------------------------------------
SHEET_CSV_URL_PROFILE=
SHEET_CSV_URL_LOCATIONS=
SHEET_CSV_URL_SERVICES=

# -----------------------------------------------------------------------
# Site URL — used for canonical URL, OG image, and sitemap
# In development: http://localhost:3000
# In production (Vercel): https://<domain>
# -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
